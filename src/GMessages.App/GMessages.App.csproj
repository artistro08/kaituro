<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GMessages.App</RootNamespace>
    <!-- The exe is named from the single display name property -->
    <AssemblyName>$(AppDisplayName)</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- System XAML (Windows.UI.Xaml) with WinUI 2.8 controls in XAML Islands, for UWP-style synced resizing.
         UseUwp brings the projections and the system XAML compiler (Visual Studio's "WinUI application development"
         workload with "Universal Windows Platform tools") -->
    <UseUwp>true</UseUwp>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Desktop only: don't add the Windows.Universal device family to the manifest -->
    <EnableAppxWindowsUniversalTargetDeviceFamilyItem>false</EnableAppxWindowsUniversalTargetDeviceFamilyItem>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Tray app with a small heap: no background GC thread and its reserved memory -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- LibraryImport And Generated COM (Microphone Consent) Generate Unsafe Code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Exe icon, drawn by scripts/Make-Icons.ps1 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Debug: unpackaged, with the test hooks compiled in. It uses the installed Windows App SDK runtime (the
       bootstrapper starts it), since unpackaged notification registration needs the runtime's Singleton package,
       which a self-contained app can't use. Release stays self-contained. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);EnableTestHooks</DefineConstants>
    <!-- System XAML in an unpackaged exe reads its compiled pages from resources.pri beside it, by that name only -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <!-- Release guard: the test hooks must never ship -->
  <Target Name="GuardTestHooks" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="$(DefineConstants.Contains('EnableTestHooks'))" Text="EnableTestHooks must not be defined in a Release build." />
  </Target>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icons and logos: the tray loads its .ico files from the output folder at runtime -->
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- Pairing Emoji: Noto Color Emoji images (googlefonts/noto-emoji, 2D/png/128), with the Apache 2.0 license they (and the Unpair icon's Material Symbols path) are under, and the repository's OFL 1.1 -->
    <Content Include="Assets\Emoji\*.png;Assets\Emoji\LICENSE-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- Fluent Emoji Font: its MIT licenses (the font itself is unzipped below) -->
    <Content Include="Assets\Fonts\LICENSE-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Assets\Fonts\FluentEmojiColor.zip" />
    <None Remove="Assets\Fonts\FluentEmojiColor.zip" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Fluent Emoji Font: kept zipped in the repository (13.5 MB, not 15.5), unzipped into obj and shipped as
       Assets\Fonts\FluentEmojiColor.ttf. scripts/Make-EmojiFont.ps1 makes the zip -->
  <Target Name="UnzipEmojiFont" BeforeTargets="AssignTargetPaths">
    <Unzip SourceFiles="Assets\Fonts\FluentEmojiColor.zip" DestinationFolder="$(IntermediateOutputPath)Fonts" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)Fonts\FluentEmojiColor.ttf" Link="Assets\Fonts\FluentEmojiColor.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Windows App SDK Without WinUI 3: notifications, single instance, power events and dynamic dependencies.
       InteractiveExperiences only because Foundation depends on it (pinned to the central version) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
  </ItemGroup>

  <!-- The MSIX Tools The UWP Targets Add: The Version Windows App SDK Base Needs, So Restore Doesn't See A Downgrade -->
  <PropertyGroup>
    <MicrosoftWindowsSDKBuildToolsMSIXPackageVersion>1.7.251221100</MicrosoftWindowsSDKBuildToolsMSIXPackageVersion>
  </PropertyGroup>

  <!-- WinUI 2.8 Controls; the runtime comes from the Microsoft.UI.Xaml.2.8 framework package (a manifest dependency
       when packaged, a dynamic dependency when not, see XamlHost) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GMessages.Presentation\GMessages.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!-- MSIX Manifest: packaged builds read the generated copy in obj, not the Package.appxmanifest template.
       An item, so IntermediateOutputPath is already final when it's evaluated. -->
  <ItemGroup Condition="'$(WindowsPackageType)' != 'None'">
    <AppxManifest Include="$(IntermediateOutputPath)Package.generated.appxmanifest" />
  </ItemGroup>

  <!-- Generate The MSIX Manifest: fills every $AppDisplayName$ in the template from the AppDisplayName property.
       Runs on every build (packaged or not) before the MSIX tooling reads the manifest, and only rewrites the
       file when the result changes. -->
  <Target Name="GenerateAppxManifest" BeforeTargets="_CheckForInvalidConfigurationAndPlatform;_ValidatePresenceOfAppxManifestItems">
    <PropertyGroup>
      <GeneratedAppxManifest>$(IntermediateOutputPath)Package.generated.appxmanifest</GeneratedAppxManifest>
      <_AppxManifestTemplate>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Package.appxmanifest'))</_AppxManifestTemplate>
      <_AppxManifestText>$(_AppxManifestTemplate.Replace('$AppDisplayName$', '$(AppDisplayName)'))</_AppxManifestText>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(GeneratedAppxManifest)" Lines="$([MSBuild]::Escape($(_AppxManifestText)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(GeneratedAppxManifest)" />
    </ItemGroup>
  </Target>

  <!-- Sign The Exe: signs the Native AOT exe itself (not just the package), so Windows keeps the tray icon's
       placement across updates. Signs it in obj right after the native link, since the publish folder and the
       package both copy it from there. Runs only when scripts/Build-Package.ps1 passes the certificate. -->
  <Target Name="SignAppExecutable" AfterTargets="LinkNative" Condition="'$(AppExeSigningThumbprint)' != '' And '$(AppExeSignTool)' != '' And Exists('$(NativeBinary)')">
    <PropertyGroup>
      <AppExeTimestampArguments Condition="'$(AppExeTimestampUrl)' != ''">/tr $(AppExeTimestampUrl) /td SHA256</AppExeTimestampArguments>
    </PropertyGroup>
    <Exec Command="&quot;$(AppExeSignTool)&quot; sign /q /fd SHA256 /sha1 $(AppExeSigningThumbprint) $(AppExeTimestampArguments) &quot;$(NativeBinary)&quot;" />
  </Target>

</Project>

<!-- Shortcut Help: the wired shortcuts, action left and its keys right as key caps (Layers' shortcut sheet look). No
     button row: the X beside the title, Escape, or a click on the dimmed window around it closes it -->
<ContentDialog
    x:Class="GMessages.App.Views.ShortcutHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Shortcuts.Dialog"
    AutomationProperties.Name="Keyboard shortcuts"
    Closed="OnClosed"
    Opened="OnOpened">

    <ContentDialog.Resources>
        <!-- Key Cap: Layers' key chip (a quiet control fill, a 1 px divider stroke, radius 4) -->
        <Style x:Key="KeyCapStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- Row: a divider line above it (the first row's is turned off in code) -->
        <Style x:Key="ShortcutRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- Joiner: the "+" between key caps -->
        <Style x:Key="KeyJoinerStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <!-- Title: the heading, and the X in the top right corner, its top lined up with the heading's. The X's negative
         right margin puts its glyph as far in from the right edge as the heading is from the left -->
    <ContentDialog.Title>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Top" Text="Keyboard shortcuts" />
            <Button
                Grid.Column="1"
                Width="32"
                Height="32"
                Margin="0,-2,-8,0"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="Shortcuts.Close"
                AutomationProperties.Name="Close"
                Click="OnCloseClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="16" Glyph="&#xE711;" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <!-- Rows: filled from ShortcutMap.HelpRows in code, a divider between each, reaching both edges. The scroller runs out
         into the dialog's 24 px right padding and the rows keep clear of it, so the scroll bar sits in that gutter, never
         over the keys -->
    <ScrollViewer Margin="0,0,-24,0">
        <StackPanel x:Name="RowsPanel" Margin="0,0,24,0" />
    </ScrollViewer>
</ContentDialog>

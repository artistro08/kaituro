<!-- Details: the conversation's people, the Mute toggle and Block & report spam. Copy is set from ChatCopy in code -->
<ContentDialog
    x:Class="GMessages.App.Views.Controls.ConversationDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GMessages.App.Views.Controls"
    xmlns:main="using:GMessages.Presentation.Main"
    xmlns:views="using:GMessages.App.Views"
    AutomationProperties.AutomationId="Dialog.Details"
    DefaultButton="Close">

    <StackPanel Spacing="12">

        <!-- People: one row per person, avatar, name and number, like a list row -->
        <TextBlock x:Name="PeopleHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <ItemsControl x:Name="PeopleList" AutomationProperties.AutomationId="Details.People">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="main:PersonRow">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:Avatar
                            VerticalAlignment="Center"
                            Color="{x:Bind Color}"
                            Initial="{x:Bind Initial}"
                            PhotoId="{x:Bind PhotoId}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                MaxLines="1"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind Number}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind views:UiHelpers.ShownIfText(Number)}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Mute: runs as soon as it's flipped, Windows-toggle style -->
        <ToggleSwitch
            x:Name="MuteSwitch"
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="Details.Mute" />

        <!-- Block & Report Spam: one-on-one chats outside spam and blocked only -->
        <Button
            x:Name="BlockButton"
            AutomationProperties.AutomationId="Details.Block"
            Click="OnBlockClick" />
    </StackPanel>
</ContentDialog>

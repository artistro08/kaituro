<UserControl
    x:Class="GMessages.App.Views.ChatsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GMessages.App.Views.Controls"
    xmlns:local="using:GMessages.App.Views"
    xmlns:main="using:GMessages.Presentation.Main">

    <!-- Panes: the list is the SplitView's pane, so ☰ slides it in and out the way Windows does; the chat is its content.
         A narrow window widens the pane to the whole window (set in code) and closes it while the chat shows -->
    <SplitView
        x:Name="Panes"
        CompactPaneLength="0"
        DisplayMode="Inline"
        IsPaneOpen="{x:Bind local:ChatsView.IsListOpen(ViewModel.IsListCollapsed, ViewModel.ShowChatPane), Mode=OneWay}"
        OpenPaneLength="360"
        PaneBackground="Transparent"
        SizeChanged="OnSizeChanged">

        <!-- List Pane: on the Mica -->
        <SplitView.Pane>
            <Grid x:Name="ListPane" RowDefinitions="Auto,Auto,Auto,Auto,*">

                <!-- Folder Header: Archived or Spam & blocked (the title bar's Back returns to the inbox) -->
                <TextBlock
                    Margin="16,8,12,8"
                    AutomationProperties.AutomationId="Main.ListTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind local:ChatsView.FolderTitle(ViewModel.IsArchivedView), Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsFolderView, Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- Connection Banner: hidden while connected -->
                <TextBlock
                    Grid.Row="1"
                    Margin="16,0,16,8"
                    AutomationProperties.AutomationId="Main.Status"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasStatusBanner, Mode=OneWay}" />

                <!-- Action Failure Banner: a conversation action the phone didn't make; closing it dismisses it. Collapsed
                     while closed: a closed InfoBar still keeps its margin, which pushed the list below the chat island's
                     top edge -->
                <InfoBar
                    Grid.Row="2"
                    Margin="16,0,16,8"
                    AutomationProperties.AutomationId="Main.ActionError"
                    CloseButtonClick="OnActionErrorClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasActionError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ActionError, Mode=OneWay, FallbackValue=''}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.HasActionError, Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- Phone Battery Banner: only after a live low battery alert; closing it hides it until the next one.
                     Collapsed while closed, as above -->
                <InfoBar
                    Grid.Row="3"
                    Margin="16,0,16,8"
                    AutomationProperties.AutomationId="Main.BatteryLow"
                    Closed="OnBatteryLowClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsPhoneBatteryLow, Mode=OneWay}"
                    Severity="Warning"
                    Title="{x:Bind local:ChatsView.BatteryTitle}"
                    Visibility="{x:Bind ViewModel.IsPhoneBatteryLow, Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- Conversations: room at the bottom so Start chat never covers the last row, and a lane on the right where
                     the scrollbar sits, between the rows and the chat island -->
                <ListView
                    x:Name="ConversationList"
                    Grid.Row="4"
                    Padding="0,0,8,64"
                    AutomationProperties.AutomationId="Main.ConversationList"
                    ContainerContentChanging="OnContainerContentChanging"
                    ContextRequested="OnConversationListContextRequested"
                    Loaded="OnConversationListLoaded"
                    SelectionChanged="OnSelectionChanged"
                    SelectionMode="Single">
                    <!-- Rows: a click opens the chat without taking the focus, so the message box keeps it and never shows its
                         unfocused look between chats (the owner saw that as a flash). Tab and the arrow keys still reach the rows -->

                    <!-- No Transitions Here: loads, pages and folder switches never animate. The code turns on Windows' add,
                         remove and reorder motion only for a live change (a new message lifting a row, see OnRowsChanging) -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>

                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="AllowFocusOnInteraction" Value="False" />
                            <!-- Every row spans the list, so each row's time ends at the same right edge -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="main:ConversationRowViewModel">
                            <controls:ConversationRow
                                x:Name="RowView"
                                MoreRequested="OnRowMoreRequested"
                                Row="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <!-- Loading More Room: below the last row while the next page loads, where the ring below shows once
                         the list is scrolled to its end -->
                    <ListView.Footer>
                        <Border Height="40" Visibility="{x:Bind ViewModel.CurrentList.IsLoadingMore, Mode=OneWay, FallbackValue=Collapsed}" />
                    </ListView.Footer>
                </ListView>

                <!-- Loading More: a small ring near the list's bottom while the next page loads (scrolling near the bottom
                     asks for it, see the code), in the room the footer keeps at the end. Outside the list: the list's
                     edge fade redraws its content through a copy, which drew the ring with no smoothing (jagged). 24 px,
                     not 20: the ring's animation is drawn for 32 px with a 4 px stroke and stretched, so 20 px gave a
                     2.5 px stroke whose edges never land on whole pixels; 24 px gives a whole 3 px -->
                <ProgressRing
                    Grid.Row="4"
                    Width="24"
                    Height="24"
                    Margin="0,0,8,72"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="Main.ListLoadingMore"
                    IsActive="{x:Bind ViewModel.CurrentList.IsLoadingMore, Mode=OneWay, FallbackValue=False}"
                    Visibility="{x:Bind ViewModel.CurrentList.IsLoadingMore, Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- Loading: while an empty list (the inbox, Archived or Spam & blocked) loads; the standard 32 px (a whole
                     4 px stroke), stated so a style change can't make it fractional -->
                <ProgressRing
                    Grid.Row="4"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Main.ListLoading"
                    IsActive="{x:Bind ViewModel.CurrentList.IsLoadingFirstPage, Mode=OneWay}" />

                <!-- Bottom Row: the Undo bar and Start chat side by side, floating over the rows. The row has no background, so
                     clicks between them still reach the rows -->
                <Grid
                    Grid.Row="4"
                    Margin="16,0,16,16"
                    VerticalAlignment="Bottom"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">

                    <!-- Undo: after an archive (only: owner), for a few seconds (the view model hides it), left of Start chat;
                         Undo puts the conversation back, the X hides it. Solid and lifted like Start chat, with room above
                         and below its text, bottoms lined up; a narrow list cuts the notice short with "…". It never takes the focus (Tab reaches it), and
                         Narrator announces the notice (see AnnounceUndo) -->
                    <Grid
                        x:Name="UndoBar"
                        Padding="12,8,8,8"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnDefinitions="*,Auto,Auto"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Translation="0,0,16"
                        Visibility="{x:Bind ViewModel.HasUndo, Mode=OneWay, FallbackValue=Collapsed}">
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>
                        <TextBlock
                            x:Name="UndoNoticeText"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Main.Undo"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.UndoNotice, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.UndoNotice, Mode=OneWay, FallbackValue=''}" />
                        <Button
                            x:Name="UndoButton"
                            Grid.Column="1"
                            MinHeight="24"
                            Margin="8,0,0,0"
                            Padding="8,1,8,2"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Main.Undo.Button"
                            Click="OnUndoClick"
                            Content="{x:Bind local:ChatsView.UndoText}"
                            GettingFocus="OnUndoGettingFocus" />

                        <!-- Close: a bare X right by Undo -->
                        <Button
                            Grid.Column="2"
                            Width="24"
                            Height="24"
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Main.Undo.Close"
                            AutomationProperties.Name="{x:Bind local:ChatsView.CloseText}"
                            Click="OnUndoClosed"
                            GettingFocus="OnUndoGettingFocus"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:ChatsView.CloseText}">
                            <FontIcon FontSize="10" Glyph="&#xE8BB;" />
                        </Button>
                    </Grid>
                    <!-- /Undo -->

                    <!-- Start Chat: floats at the bottom right over the inbox, the standard accent button's size; scrolling
                         down slides it away, scrolling up brings it back (set from code on the backing, animated by its
                         transitions). The backing is solid: Windows' hover, pressed and disabled accent fills are
                         see-through, and the rows showed through the button -->
                    <Grid
                        x:Name="StartChatHost"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Translation="0,0,16"
                        Visibility="{x:Bind local:MainWindow.HiddenIf(ViewModel.IsFolderView), Mode=OneWay}">
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>
                        <Grid.OpacityTransition>
                            <ScalarTransition />
                        </Grid.OpacityTransition>
                        <Grid.TranslationTransition>
                            <Vector3Transition />
                        </Grid.TranslationTransition>
                        <Button
                            x:Name="StartChatButton"
                            AutomationProperties.AutomationId="Main.StartChat"
                            Click="OnStartChatClick"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                                <TextBlock x:Name="StartChatText" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- /Start Chat -->
                </Grid>
                <!-- /Bottom Row -->
            </Grid>
        </SplitView.Pane>
        <!-- /List Pane -->

        <!-- Chat Pane: the island, with the list's resize edge in the gap to its left. The gap is there with the list
             open, collapsed (☰) or in a narrow window, so the island always sits clear of the window's edges -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind local:ChatsView.GapWidth(ViewModel.IsNarrow, ViewModel.IsListCollapsed), Mode=OneWay}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Resize Edge: drag (or arrow keys once focused) to resize the list; wide windows with the list open only -->
            <controls:PaneSplitter
                x:Name="ListSplitter"
                AutomationProperties.AutomationId="Main.ListSplitter"
                Resized="OnListResized"
                ResizeCompleted="OnListResizeCompleted"
                Visibility="{x:Bind local:ChatsView.SplitterVisibility(ViewModel.IsNarrow, ViewModel.IsListCollapsed), Mode=OneWay}" />

            <!-- Chat Island: the empty state, the open conversation or Start chat, above the Mica like Windows' own apps
                 (Settings, File Explorer): rounded, the same gap on its left, right and bottom -->
            <Grid
                x:Name="ChatArea"
                Grid.Column="1"
                Margin="0,0,8,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind local:ChatsView.ChatVisibility(ViewModel.IsNarrow, ViewModel.ShowChatPane, ViewModel.IsListCollapsed), Mode=OneWay}">

                <!-- Empty State: a large chat glyph above the prompt -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="{x:Bind local:ChatsView.EmptyStateVisibility(ViewModel.IsChatOpen, ViewModel.IsStartChatOpen), Mode=OneWay}">
                    <FontIcon
                        FontSize="96"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8BD;" />
                    <TextBlock
                        x:Name="EmptyStateText"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="Main.EmptyState"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>

                <!-- Conversation -->
                <local:ChatPane
                    x:Name="ChatView"
                    Chat="{x:Bind ViewModel.Chat, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsChatOpen, Mode=OneWay}" />

                <!-- Start Chat -->
                <local:StartChatPane
                    x:Name="StartChatView"
                    StartChat="{x:Bind ViewModel.StartChat, Mode=OneWay}"
                    Started="OnChatStarted"
                    Visibility="{x:Bind ViewModel.IsStartChatOpen, Mode=OneWay}" />
            </Grid>
            <!-- /Chat Island -->
        </Grid>
        <!-- /Chat Pane -->
    </SplitView>
</UserControl>
